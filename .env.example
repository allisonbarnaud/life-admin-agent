# Shared password gate for the chat UI, /api/labs/*, and Eve browser channel
CHAT_PASSWORD=
# Optional signing secret for the session cookie (defaults from CHAT_PASSWORD)
AUTH_SECRET=

# Model / Eve (prefer AI Gateway). Chat model is chosen in the UI (x-life-admin-model),
# not via env — default is anthropic/claude-sonnet-5.
AI_GATEWAY_API_KEY=

# Or link a Vercel project and pull OIDC locally:
#   npx vercel link
#   npx vercel env pull .env.local

# Raw @vercel/sandbox lab (/api/labs/sandbox) when not on Vercel OIDC
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# Optional: override docker binary for Eve local sandbox
# EVE_DOCKER_PATH=
