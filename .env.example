# Model / Eve (prefer AI Gateway)
AI_GATEWAY_API_KEY=

# Or link a Vercel project and pull OIDC locally:
#   npx vercel link
#   npx vercel env pull .env.local

# Raw @vercel/sandbox lab (/api/labs/sandbox) when not on Vercel OIDC
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# Optional: override docker binary for Eve local sandbox
# EVE_DOCKER_PATH=
